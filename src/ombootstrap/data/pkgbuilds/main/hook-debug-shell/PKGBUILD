package() {
    install -Dm644 "$srcdir"/hook-debug-shell.conf "$pkgdir"/etc/kupfer/mkinitcpio.conf.d/40-debug-shell.conf
    install -Dm755 "$srcdir"/hooks.sh "$pkgdir"/usr/lib/initcpio/hooks/debugshell
    install -Dm755 "$srcdir"/install.sh "$pkgdir"/usr/lib/initcpio/install/debugshell
    install -Dm644 "$srcdir"/init-kupfer-debug "$pkgdir"/usr/lib/initcpio/init-kupfer-debug
    install -Dm644 "$srcdir"/init_functions-kupfer-debug "$pkgdir"/usr/lib/initcpio/init_functions-kupfer-debug
    install -Dm755 "$srcdir"/initramfs-green-screen "$pkgdir"/usr/bin/initramfs-green-screen
    install -Dm755 "$srcdir"/initramfs-usb-telnet "$pkgdir"/usr/bin/initramfs-usb-telnet

    for image in "$srcdir"/green-*.ppm.gz; do
        install -Dm644 "$image" "$pkgdir/usr/share/initramfs/${image##*/}"
    done
}
