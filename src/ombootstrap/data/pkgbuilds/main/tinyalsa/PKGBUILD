_mode=host
_crossdirect=false
pkgname=tinyalsa
pkgver=v2.0.0.r45.g4fbaeef
pkgrel=3
_arches=specific
arch=(
    #x86_64
    aarch64
    #armv7h
)
license=(custom)
url="https://github.com/${pkgname}/${pkgname}"
depends=(glibc)
makedepends=(
    cmake
    git
)
_commit=4fbaeef03cd1cb216e0f356c0433ca70f8b9c464
source=("git+$url#commit=$_commit")
sha256sums=(SKIP)

prepare() {
    cd "${srcdir}/${pkgname}"
    # CMake 4 no longer accepts the project's pre-3.5 compatibility mode.
    sed -i '1s/cmake_minimum_required(VERSION [^)]*)/cmake_minimum_required(VERSION 3.5)/' CMakeLists.txt
}

pkgver() {
    git -C "${srcdir}/${pkgname}" describe --tags | sed 's/-/.r/;s/-/./g' | sed 's|^vV||'
}

build() {
    # avoid warnings about comparing signed and unsigned ints being treated as errors
    local _cflags="${CFLAGS//-fuse-linker-plugin/}"
    _cflags="${_cflags//-flto=auto/}"
    _cflags="${_cflags//-flto/} -Wno-error=sign-compare -fno-lto"
    local _ldflags="${LDFLAGS//-fuse-linker-plugin/}"
    _ldflags="${_ldflags//-flto=auto/}"
    _ldflags="${_ldflags//-flto/}"

    rm -rf "${srcdir}/build"
    CC=/usr/bin/gcc CFLAGS="$_cflags" LDFLAGS="$_ldflags" \
    cmake -S "${srcdir}/${pkgname}" -B "${srcdir}/build" \
        -DCMAKE_C_COMPILER=/usr/bin/gcc \
        -DCMAKE_INSTALL_PREFIX="/usr" \
        -DCMAKE_BUILD_TYPE="Release" \
        -DTINYALSA_USES_PLUGINS="ON"
    cmake --build "${srcdir}/build"
}

package() {
    DESTDIR="${pkgdir}" cmake --install "${srcdir}/build"
    install -Dm644 "${srcdir}/${pkgname}/NOTICE" \
        "${pkgdir}/usr/share/licenses/${pkgname}/NOTICE"
}

