_mode=host
_crossdirect=false
# Maintainer: Ash <xash at riseup d0t net>
# Contributor: Aren <rn+aur@peacevolution.org>
pkgname=wvkbd
pkgdesc="On-screen keyboard for wlroots"
pkgver=0.20
pkgrel=4
_arches=all
arch=(
    x86_64
    i686
    armv7h
    aarch64
)
license=("GPL3")
url="https://git.sr.ht/~proycon/wvkbd"
depends=(
    wayland
    pango
    cairo
    glibc
)
makedepends=(
    fontconfig
    libxkbcommon
    scdoc
    gcc
    binutils
)
source=("$pkgname-$pkgver.tar.gz::https://git.sr.ht/~proycon/wvkbd/archive/v$pkgver.tar.gz")
sha256sums=(SKIP)

build() {
  local _builddir="$pkgname-v$pkgver"

  # Keep the Makefile's pkg-config CFLAGS intact so Pango's non-default
  # include directory (/usr/include/pango-1.0) is passed to gcc.  Crossdirect
  # and LTO are disabled at the package level above.
  make -C "$_builddir" clean || true
  make -C "$_builddir" \
    CC=/usr/bin/gcc \
    AR=/usr/bin/ar \
    PKG_CONFIG=/usr/bin/pkg-config
}

package() {
  make -C "$pkgname-v$pkgver" PREFIX=/usr DESTDIR="$pkgdir" install
}
